// Cloudflare Workers static-assets deploy for the M1-UI web (no server code yet).
// Dashboard: build command `npm run build:web`, deploy command `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "citylight-demo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/web/dist",
    // Deep links (/alarms, /incidents/…) serve index.html; React Router handles the route.
    "not_found_handling": "single-page-application"
  }
}
