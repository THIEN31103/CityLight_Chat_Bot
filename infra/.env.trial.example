# Trial stack of one customer (docs/trial.md). Do not fill by hand: infra/scripts/gen-trial-env.sh writes
# infra/.env.trial (gitignored, mode 600) with fresh random secrets. Every secret differs from production.
POSTGRES_USER=citylight
POSTGRES_PASSWORD=
POSTGRES_DB=citylight
REDIS_PASSWORD=
# 2FA secret encryption key, 32 bytes hex
TOTP_ENC_KEY=
AUTH_REQUIRE_2FA=true

# Backend account on the customer broker (listener 1885, reached over WireGuard): username is also the ACL identity
MQTT_BACKEND_USER=
MQTT_BACKEND_PASSWORD=
TRIAL_MQTT_URL=mqtt://10.88.0.2:1885
# Cabinet account on the customer broker port 1883 (16-64 letters/digits): goes into the trial firmware build
# (Mylib/mqtt_secret.h), never the production password
MQTT_DEVICE_USERNAME=citylight-cab
MQTT_DEVICE_PASSWORD=
# D7-lite master of this customer, 64 hex: same value in the trial firmware build (Mylib/sign_secret.h).
# Keep a copy outside the VPS: losing it = re-flashing every trial cabinet.
DEVICE_MASTER_KEY=
# Customer EMQX dashboard (not published; emqx ctl / REST API inside the container)
EMQX_DASHBOARD_PASSWORD=

# Web host of the trial (Caddy site, infra/caddy/trial.caddy reads TRIAL_HOST from infra/.env)
SITE_HOST=trial.13-55-91-187.sslip.io
# Bot of its own or empty (one getUpdates poller per bot: production already polls its bot)
TELEGRAM_BOT_TOKEN=

# First admin of the trial database (trial-ctl.sh seed). Bảo keeps this account; the customer gets a manager.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
