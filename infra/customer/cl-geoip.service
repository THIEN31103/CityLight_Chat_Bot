[Unit]
Description=CityLight trial: MQTT 1883 only from Vietnamese IPv4 (layer 4, docs/trial.md)
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/cl-geoip.sh start
ExecStop=/usr/local/sbin/cl-geoip.sh stop
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
