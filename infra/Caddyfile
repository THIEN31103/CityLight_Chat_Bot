# VPS front door (M11): HTTPS via Let's Encrypt for SITE_HOST (a real domain, or <ip-with-dashes>.sslip.io
# until there is one), API + Socket.IO to the api container, everything else = the web build (SPA).
# S60: the site body is the snippet below (args: api upstream, public host) so a trial stack can reuse it:
# enabled sites in caddy-sites/*.caddy (gitignored copies of infra/caddy/*.caddy, see docs/trial.md).
(citylight) {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {args[0]}
	}
	handle /socket.io/* {
		reverse_proxy {args[0]}
	}
	handle {
		root * /srv/web
		# hashed assets never change; index.html must always be fresh
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		# CSP (2026-10-20): scripts only from this site (the build has no inline script and needs no eval);
		# inline styles stay allowed (React style attributes); map styles / tiles / glyphs from the basemap
		# hosts in apps/web/src/pages/map/mapStyle.ts (add a host there = add it here); MapLibre workers are blobs.
		# Tested by `E2E_CSP=1 npm run e2e:browser` (reads this line).
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tiles.openfreemap.org https://tiles.versatiles.org https://*.cartocdn.com https://server.arcgisonline.com; connect-src 'self' wss://{args[1]} https://tiles.openfreemap.org https://tiles.versatiles.org https://*.cartocdn.com https://server.arcgisonline.com; font-src 'self' data:; worker-src 'self' blob:; child-src blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		# map "my location" button + incident photo capture keep geolocation / camera for this site only
		Permissions-Policy "camera=(self), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=()"
		-Server
	}
}

{$SITE_HOST} {
	import citylight api:3000 {$SITE_HOST}
}

import caddy-sites/*.caddy
