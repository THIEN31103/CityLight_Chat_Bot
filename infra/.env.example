# Copy to infra/.env (never commit .env) and set real secrets.
EMQX_DASHBOARD_PASSWORD=change-me-dashboard
POSTGRES_USER=citylight
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=citylight
REDIS_PASSWORD=change-me-redis
# Random token, >= 20 chars [A-Za-z0-9_-]; acts as the backend credential in phase 1.
MQTT_BACKEND_USER=cl-backend-change-me-random-token
# S43: one MQTT account shared by every cabinet, required on port 1883 (the backend uses the internal listener 1885).
# Password: 16-64 letters/digits (it goes inside an EC25 AT+QMTCONN argument). Empty = 1883 refuses every cabinet.
MQTT_DEVICE_USERNAME=
MQTT_DEVICE_PASSWORD=
# 2FA secret encryption key, 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=
# false = 2FA not forced for admin/operator (local tests only)
AUTH_REQUIRE_2FA=true

# M5 notifications: bot token from @BotFather (empty = Telegram off); WEB_URL = link in messages
TELEGRAM_BOT_TOKEN=
WEB_URL=

# M11 VPS only: public host name served by Caddy (HTTPS). No domain yet: <ip-with-dashes>.sslip.io
SITE_HOST=
