# /etc/wireguard/wg0.conf on the VPS (trial A′, docs/trial.md). Keys are generated on each machine and never copied:
#   umask 077; wg genkey | tee /etc/wireguard/vps.key | wg pubkey > /etc/wireguard/vps.pub
# Lightsail firewall: UDP 51820 from the customer egress IP only.
# The customer only reaches the VPS answers: every NEW connection coming in from wg0 is dropped, towards the host
# (INPUT) and towards containers (DOCKER-USER, also for ports Docker publishes). The trial workers dial out to
# 10.88.0.2:1885 through the host route (Docker masquerades them as 10.88.0.1).
[Interface]
Address = 10.88.0.1/24
ListenPort = 51820
PrivateKey = <contents of /etc/wireguard/vps.key>
PostUp = iptables -I INPUT -i %i -m conntrack --ctstate NEW -j DROP; iptables -N DOCKER-USER 2>/dev/null || true; iptables -I DOCKER-USER -i %i -m conntrack --ctstate NEW -j DROP
PostDown = iptables -D INPUT -i %i -m conntrack --ctstate NEW -j DROP; iptables -D DOCKER-USER -i %i -m conntrack --ctstate NEW -j DROP

[Peer]
# customer machine
PublicKey = <contents of the customer's /etc/wireguard/customer.pub>
AllowedIPs = 10.88.0.2/32
