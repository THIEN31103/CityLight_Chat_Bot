{
  "name": "citylight-jarvis",
  "private": true,
  "version": "0.1.0",
  "description": "Jarvis: Vietnamese text + voice operations assistant for CityLight. Runs on its own and talks to a CityLight server only through its HTTP API.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run start -w @citylight/jarvis",
    "test": "vitest run",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "smoke": "npm run smoke -w @citylight/jarvis --",
    "bench:llm": "npm run bench:llm -w @citylight/jarvis --",
    "bench:voice": "npm run bench:voice -w @citylight/jarvis --"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
