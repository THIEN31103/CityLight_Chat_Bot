{
  "name": "citylight-server",
  "private": true,
  "version": "0.1.0",
  "description": "CityLight smart-lighting platform: MQTT ingest, API, web",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @citylight/web",
    "build:web": "npm run build -w @citylight/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "infra:up": "node infra/scripts/gen-emqx-acl.mjs && docker compose -f infra/docker-compose.yml --env-file infra/.env up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml --env-file infra/.env down",
    "db:migrate": "npm run migrate -w @citylight/db",
    "sim": "npm run start -w @citylight/simulator --",
    "e2e:local": "npm run e2e:local -w @citylight/simulator",
    "e2e:api": "node --env-file=.env --import tsx apps/api/test/e2e-auth.ts",
    "e2e:commands": "node --env-file=.env --import tsx apps/api/test/e2e-commands.ts",
    "e2e:map": "node --env-file=.env --import tsx apps/api/test/e2e-map.ts",
    "e2e:alarms": "node --env-file=.env --import tsx apps/api/test/e2e-alarms.ts",
    "e2e:schedules": "node --env-file=.env --import tsx apps/api/test/e2e-schedules.ts",
    "e2e:incidents": "node --env-file=.env --import tsx apps/api/test/e2e-incidents.ts",
    "e2e:gis": "node --env-file=.env --import tsx apps/api/test/e2e-gis.ts",
    "e2e:admin": "node --env-file=.env --import tsx apps/api/test/e2e-admin.ts",
    "e2e:dimming": "node --env-file=.env --import tsx apps/api/test/e2e-dimming.ts",
    "e2e:relocate": "node --env-file=.env --import tsx apps/api/test/e2e-relocate.ts",
    "e2e:guards": "node --env-file=.env --import tsx apps/api/test/e2e-guards.ts",
    "e2e:logo": "node --env-file=.env --import tsx apps/api/test/e2e-logo.ts",
    "e2e:security": "node --env-file=.env --import tsx apps/api/test/e2e-security.ts",
    "e2e:roles": "node --env-file=.env --import tsx apps/api/test/e2e-roles.ts",
    "e2e:mqtt-auth": "node --env-file=.env --env-file=infra/.env --import tsx apps/api/test/e2e-mqtt-auth.ts",
    "e2e:exports": "node --env-file=.env --import tsx apps/api/test/e2e-exports.ts",
    "e2e:cmdtopic": "node --env-file=.env --env-file=infra/.env --import tsx apps/api/test/e2e-cmdtopic.ts",
    "e2e:batch-control": "node --env-file=.env --import tsx apps/api/test/e2e-batch-control.ts",
    "db:seed": "npm run seed -w @citylight/db",
    "sim:register": "npm run register -w @citylight/simulator --",
    "dev:web:hybrid": "npm run dev:hybrid -w @citylight/web",
    "dev:api": "npm run dev -w @citylight/api",
    "dev:ingest": "npm run dev -w @citylight/workers",
    "dev:cmd": "npm run dev:cmd -w @citylight/workers",
    "dev:notify": "npm run dev:notify -w @citylight/workers",
    "dev:scheduler": "npm run dev:scheduler -w @citylight/workers",
    "e2e:browser": "npm run test -w @citylight/e2e",
    "e2e:vps": "npm run test:vps -w @citylight/e2e"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "fastify": "5.12.7",
    "uuid": "11.1.1"
  }
}
