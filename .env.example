# App-side settings (copy to .env). Must match infra/.env.
DATABASE_URL=postgres://citylight:change-me-db@localhost:5432/citylight
REDIS_URL=redis://:change-me-redis@localhost:6379
# backend listener (no authn, loopback only); cabinets use 1883 with the device account (S43)
MQTT_URL=mqtt://localhost:1885
MQTT_USERNAME=cl-backend-change-me-random-token
# Local admin created by npm run db:seed (password >= 12 chars)
SEED_ADMIN_EMAIL=admin@citylight.local
SEED_ADMIN_PASSWORD=change-me-admin-password
# 2FA secret encryption key, 32 bytes hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOTP_ENC_KEY=
# false = 2FA not forced for admin/operator (local tests only)
AUTH_REQUIRE_2FA=true
# Must match infra/.env. S59 command signing (D7-lite): 32-byte master of THIS environment / customer, 64 hex; the same value goes into the
# LTE firmware build (Mylib/sign_secret.h). Keep a copy outside the server: losing it = re-flashing every cabinet.
# Empty = identities not checked, no cabinet signed. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICE_MASTER_KEY=

# M5 notifications: bot token from @BotFather (empty = Telegram off); WEB_URL = link in messages
TELEGRAM_BOT_TOKEN=
WEB_URL=
