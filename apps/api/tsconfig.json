{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"],
    // NestJS decorators. No emitDecoratorMetadata: tsx/esbuild cannot emit it, so every
    // constructor dependency uses an explicit @Inject(token).
    "experimentalDecorators": true
  },
  "include": ["src"]
}
