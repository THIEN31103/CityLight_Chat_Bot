# apps/jarvis/.env — copy this file to .env (gitignored) and fill it in. Never commit .env.

# CityLight API Jarvis talks to (local stack by default; trial only with Bảo's OK, milestone 5)
CITYLIGHT_API_BASE=http://localhost:3000/api/v1
# per-request timeout for API reads (ms)
JARVIS_API_TIMEOUT_MS=5000

# Brain: ollama = free local model (default), fake = test provider (never for real use)
LLM_PROVIDER=ollama
# qwen3:4b-instruct answers at once; plain qwen3:4b is a thinking-only build (~60 s per answer on a 4 GB GPU)
LLM_MODEL=qwen3:4b-instruct
OLLAMA_URL=http://127.0.0.1:11434
LLM_MAX_TOKENS=1024
LLM_NUM_CTX=4096
# thinking models only: false asks the model to answer at once; leave empty for the model's default
LLM_THINK=

# Voice (milestone 3): faster-whisper sidecar for STT, edge-tts for TTS
STT_PROVIDER=faster-whisper
STT_MODEL=small
TTS_PROVIDER=edge-tts
TTS_VOICE=vi-VN-NamMinhNeural

# Guard (milestone 4). Empty allowlist = no cabinet can be controlled (fail closed).
JARVIS_CABINET_ALLOWLIST=DM0001..DM0010
JARVIS_ACTIONS_ENABLED=true

# Limits. 0 = no hard cap. The console can lower the daily cap but never above the MAX.
JARVIS_DAILY_TOKEN_CAP_MAX=0
JARVIS_DAILY_TOKEN_CAP=0
JARVIS_PER_USER_PER_MIN=10
JARVIS_HISTORY_DAYS=90

# Console: loopback only by default. A LAN address needs a token of at least 24 characters.
JARVIS_CONSOLE_HOST=127.0.0.1
JARVIS_CONSOLE_PORT=8790
JARVIS_CONSOLE_TOKEN=
# where jarvis.db and audit/*.jsonl live (gitignored); relative to apps/jarvis
JARVIS_DATA_DIR=data
